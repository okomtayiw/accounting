<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.AccountingSystem" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/window_bg</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Background -->
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="colorOnBackground">@color/text_primary</item>

        <!-- Surface -->
        <item name="colorSurface">@color/soft_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorBackgroundFloating">@color/purple_500</item>

        <!-- Status bar -->
        <item name="android:statusBarColor" tools:targetApi="21">@color/purple_700</item>

        <!-- Typography -->
        <item name="fontFamily">@font/accounting_font</item>

    </style>

</resources>
