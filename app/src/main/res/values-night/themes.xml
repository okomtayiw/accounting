<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- DARK THEME -->
    <style name="Theme.AccountingSystem" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- ===== PRIMARY ===== -->
        <item name="colorPrimary">@color/blue</item>
        <item name="colorPrimaryVariant">@color/blue_pressed</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- ===== BACKGROUND ===== -->
        <item name="android:colorBackground">@color/category_screen_bg</item>
        <item name="android:windowBackground">@color/category_screen_bg</item>
        <item name="colorOnBackground">@color/text_primary</item>

        <!-- ===== SURFACE ===== -->
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- ===== STATUS BAR (FIX API 34) ===== -->
        <!-- Opaque black background, ikon terang -->
        <item name="android:statusBarColor">#000000</item>
        <item name="android:windowLightStatusBar" tools:ignore="NewApi">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>

        <!-- ===== NAVIGATION BAR ===== -->
        <item name="android:navigationBarColor">#000000</item>

        <!-- ===== FONT ===== -->
        <item name="fontFamily">@font/accounting_font</item>

        <!-- ===== INPUT ===== -->
        <item name="colorInputBackground">@color/input_bg_dark</item>
        <item name="colorInputStroke">@color/input_stroke_dark</item>

        <item name="tabUnselectedTextColor">@color/white</item>
    </style>
    <!-- Base application theme. -->
    <style name="Base.Theme.AccountingSystem" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
    </style>

</resources>
