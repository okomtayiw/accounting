<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Custom Toolbar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/custom_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Tombol kembali -->
        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back Button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Judul -->
        <TextView
            android:id="@+id/toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_journal"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            app:layout_constraintStart_toEndOf="@id/btn_back"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        app:layout_constraintTop_toBottomOf="@id/custom_toolbar"
        app:layout_constraintBottom_toTopOf="@id/btnSave"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Input Description -->
            <LinearLayout
                android:id="@+id/layoutDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#F5F7FF"
                android:padding="12dp"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <!-- Icon Description -->
                <ImageView
                    android:id="@+id/iconDescription"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_journal"
                    android:contentDescription="Description Icon"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/inputDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Description"
                    android:background="@android:color/transparent"
                    android:inputType="text"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Input Total Debit -->
            <LinearLayout
                android:id="@+id/layout_account_name_one"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#F5F7FF"
                android:padding="12dp"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <!-- Icon Debit -->
                <ImageView
                    android:id="@+id/iconDebit"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_account_balance_wallet"
                    android:contentDescription="Debit Icon"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/account_name_one"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Select account assets"
                    android:background="@android:color/transparent"
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:gravity="center_vertical" />
            </LinearLayout>

            <!-- Input Total Credit -->
            <LinearLayout
                android:id="@+id/layout_account_name_two"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#F5F7FF"
                android:padding="12dp"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <!-- Icon Credit -->
                <ImageView
                    android:id="@+id/iconCredit"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_account_balance_wallet"
                    android:contentDescription="Credit Icon"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/account_name_two"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Select account expenses"
                    android:background="@android:color/transparent"
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:gravity="center_vertical" />
            </LinearLayout>

            <!-- Input Total Uang -->
            <LinearLayout
                android:id="@+id/layoutTotalAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#F5F7FF"
                android:padding="12dp"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <!-- Icon Total Amount -->
                <ImageView
                    android:id="@+id/iconTotalAmount"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_journal"
                    android:contentDescription="Total Amount Icon"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/inputTotalAmount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Total Amount"
                    android:background="@android:color/transparent"
                    android:inputType="numberDecimal"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Input Date -->
            <LinearLayout
                android:id="@+id/layoutDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#F5F7FF"
                android:padding="12dp"
                android:elevation="2dp"
                android:gravity="center_vertical">

                <!-- Icon Date -->
                <ImageView
                    android:id="@+id/iconDate"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_calendar"
                    android:contentDescription="Date Icon"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/inputDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Date (yyyy-MM-dd)"
                    android:background="@android:color/transparent"
                    android:textSize="16sp"
                    android:focusable="false"
                    android:clickable="true"
                    android:inputType="none"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Save Button -->
    <Button
        android:id="@+id/btnSave"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_margin="16dp"
        android:text="Save"
        android:backgroundTint="@color/purple_500"
        android:textColor="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="12dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
