<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/category_table_width"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="false">

    <TextView
        android:id="@+id/tvNo"
        android:layout_width="@dimen/col_no"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingHorizontal="@dimen/cell_pad_h"
        android:paddingVertical="@dimen/cell_pad_v"
        android:background="#FFFFFF"
        android:textColor="@color/black" />

    <!-- Account + Date -->
    <LinearLayout
        android:layout_width="@dimen/col_account"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/cell_pad_h"
        android:paddingVertical="@dimen/cell_pad_v"
        android:background="#C8E6C9">

        <TextView
            android:id="@+id/tvAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@android:color/holo_red_light"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDesc"
        android:layout_width="@dimen/col_desc"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/cell_pad_h"
        android:paddingVertical="@dimen/cell_pad_v"
        android:background="#FFF9C4"
        android:maxLines="3"
        android:textColor="@color/black" />

    <TextView
        android:id="@+id/tvTotal"
        android:layout_width="@dimen/col_debit"
        android:layout_height="match_parent"
        android:singleLine="true"
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:paddingHorizontal="@dimen/cell_pad_h"
        android:paddingVertical="@dimen/cell_pad_v"
        android:background="#E1F5FE"
        android:textSize="13sp"
        android:textColor="@color/black" />

</LinearLayout>
