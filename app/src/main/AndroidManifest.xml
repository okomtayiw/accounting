<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" /> <!-- Features -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-feature
        android:name="com.google.ar.core"
        android:required="false"
        tools:node="merge" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AccountingSystem"
        tools:targetApi="35">

        <meta-data
            android:name="com.google.ar.core.min_apk_version"
            tools:node="remove" />


        <activity
            android:name=".ui.transactions.ActivityCategoryPreview"
            android:exported="false" />
        <activity
            android:name=".ui.transactions.ActivityTransactionLedgerPreview"
            android:exported="false" />
        <activity
            android:name=".ui.transactions.ActivityProfitLossPreview"
            android:exported="false" />
        <activity
            android:name=".ui.transactions.ActivityBalanceSheetPreview"
            android:exported="false"
            android:theme="@style/Theme.AccountingSystem" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>




    </application>

</manifest>